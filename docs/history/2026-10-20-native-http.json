  "probe_source": "<?php\n\ndeclare(strict_types=1);\n\n$start = hrtime(true);\nrequire $argv[1] . '/bootstrap.php';\n$compose = require $argv[1] . '/config/core.php';\n$app = $compose(new App\\Platform\\Logging\\ReadableOutputLogger());\n$startup = hrtime(true) - $start;\n$startupBytes = memory_get_usage();\n$classes = count(get_declared_classes());\n$requestClass = $argv[2] === 'before' ? Nyholm\\Psr7\\ServerRequest::class : App\\Platform\\Http\\Request::class;\n$start = hrtime(true);\nfor ($i = 0; $i < 10000; ++$i) {\n    $request = new $requestClass('GET', '/health', ['X-Request-ID' => 'native-http-measure']);\n    $response = $app->handle($request);\n    if ($response->getStatusCode() !== 200 || $response->getHeaderLine('Content-Type') !== 'application/json' || $response->getHeaderLine('X-Request-ID') !== 'native-http-measure' || (string) $response->getBody() !== '{\"status\":\"ok\"}') {\n        throw new RuntimeException('Different measured response.');\n    }\n    $response->getBody()->close();\n    $request->getBody()->close();\n    unset($request, $response);\n}\necho json_encode([\n    'startup_ms' => $startup / 1000000,\n    'requests_ms' => (hrtime(true) - $start) / 1000000,\n    'loaded_classes' => $classes,\n    'startup_php_bytes' => $startupBytes,\n    'after_requests_php_bytes' => memory_get_usage(),\n    'peak_php_bytes' => memory_get_peak_usage(),\n    'included_files' => count(get_included_files()),\n], JSON_THROW_ON_ERROR), \"\\n\";\n",
