%token T_SELECT      (?i:select)(?![a-zA-Z0-9_])
%token T_FROM        (?i:from)(?![a-zA-Z0-9_])
%token T_JOIN        (?i:join)(?![a-zA-Z0-9_])
%token T_INNER       (?i:inner)(?![a-zA-Z0-9_])
%token T_LEFT        (?i:left)(?![a-zA-Z0-9_])
%token T_RIGHT       (?i:right)(?![a-zA-Z0-9_])
%token T_FULL        (?i:full)(?![a-zA-Z0-9_])
%token T_ON          (?i:on)(?![a-zA-Z0-9_])
%token T_WHERE       (?i:where)(?![a-zA-Z0-9_])
%token T_ORDER       (?i:order)(?![a-zA-Z0-9_])
%token T_BY          (?i:by)(?![a-zA-Z0-9_])
%token T_AS          (?i:as)(?![a-zA-Z0-9_])
%token T_AND         (?i:and)(?![a-zA-Z0-9_])
%token T_OR          (?i:or)(?![a-zA-Z0-9_])
%token T_CASE        (?i:case)(?![a-zA-Z0-9_])
%token T_WHEN        (?i:when)(?![a-zA-Z0-9_])
%token T_THEN        (?i:then)(?![a-zA-Z0-9_])
%token T_ELSE        (?i:else)(?![a-zA-Z0-9_])
%token T_END         (?i:end)(?![a-zA-Z0-9_])
%token T_ASC         (?i:asc)(?![a-zA-Z0-9_])
%token T_DESC        (?i:desc)(?![a-zA-Z0-9_])
%token T_INSERT      (?i:insert)(?![a-zA-Z0-9_])
%token T_INTO        (?i:into)(?![a-zA-Z0-9_])
%token T_VALUES      (?i:values)(?![a-zA-Z0-9_])
%token T_CONFLICT    (?i:conflict)(?![a-zA-Z0-9_])
%token T_DO          (?i:do)(?![a-zA-Z0-9_])
%token T_UPDATE      (?i:update)(?![a-zA-Z0-9_])
%token T_SET         (?i:set)(?![a-zA-Z0-9_])
%token T_RETURNING   (?i:returning)(?![a-zA-Z0-9_])
%token T_DELETE      (?i:delete)(?![a-zA-Z0-9_])
%token T_EXCLUDED    (?i:excluded)(?![a-zA-Z0-9_])
%token T_IDENT       [a-zA-Z_][a-zA-Z0-9_]*
%token T_COLON       :
%token T_COMMA       ,
%token T_DOT         \.
%token T_STAR        \*
%token T_EQ          =
%token T_LE          <=
%token T_GE          >=
%token T_LT          <
%token T_GT          >
%token T_LPAREN      \(
%token T_RPAREN      \)
%token T_SEMICOLON   ;
%skip  T_WS          \s+

#Query: SelectStmt() | InsertStmt() | UpdateStmt() | DeleteStmt();
#SelectStmt: <T_SELECT> SelectList() <T_FROM> TableRef() JoinClause()* WhereClause()? OrderByClause()? <T_SEMICOLON>?;
#InsertStmt: <T_INSERT> <T_INTO> <T_IDENT> <T_LPAREN> IdentList() <T_RPAREN> <T_VALUES> <T_LPAREN> PlaceholderList() <T_RPAREN> ConflictClause()? ReturningClause()? <T_SEMICOLON>?;
#DeleteStmt: <T_DELETE> <T_FROM> <T_IDENT> WhereClause() <T_SEMICOLON>?;
#UpdateStmt: <T_UPDATE> <T_IDENT> <T_SET> UpdateAssignments() WhereClause()? ReturningClause()? <T_SEMICOLON>?;
#UpdateAssignments: UpdateAssignment() (<T_COMMA> UpdateAssignment())*;
#UpdateAssignment: <T_IDENT> <T_EQ> Placeholder();
#SelectList: SelectItem() (<T_COMMA> SelectItem())*;
#SelectItem: WildcardSelection() | AliasedCase() | AliasedFunction() | AliasedColumn();
#AliasedColumn: ColumnRef() ((<T_AS>)? <T_IDENT>)?;
#AliasedCase: CaseExpr() ((<T_AS>)? <T_IDENT>)?;
#AliasedFunction: FunctionCall() ((<T_AS>)? <T_IDENT>)?;
#FunctionCall: <T_IDENT> <T_LPAREN> (OperandList() | <T_STAR>) <T_RPAREN>;
#CaseExpr: <T_CASE> WhenClause()+ ElseClause() <T_END>;
#WhenClause: <T_WHEN> ComparisonExpr() <T_THEN> Operand();
#ElseClause: <T_ELSE> Operand();
#OperandList: Operand() (<T_COMMA> Operand())*;
#WildcardSelection: (<T_IDENT> <T_DOT>)? <T_STAR>;
#ColumnRef: (<T_IDENT> <T_DOT>)? <T_IDENT>;
#TableRef: <T_IDENT> ((<T_AS>)? <T_IDENT>)?;
#JoinClause: JoinType()? <T_JOIN> TableRef() <T_ON> ComparisonExpr();
#JoinType: <T_INNER> | <T_LEFT> | <T_RIGHT> | <T_FULL>;
#WhereClause: <T_WHERE> ComparisonExpr() ((<T_AND> | <T_OR>) ComparisonExpr())*;
#OrderByClause: <T_ORDER> <T_BY> OrderItem() (<T_COMMA> OrderItem())*;
#OrderItem: ColumnRef() ((<T_ASC>) | (<T_DESC>))?;
#ComparisonExpr: Operand() CompareOp() Operand();
#Operand: ColumnRef() | Placeholder();
#Placeholder: <T_COLON> <T_IDENT>;
#CompareOp: <T_EQ> | <T_LE> | <T_GE> | <T_LT> | <T_GT>;
#IdentList: <T_IDENT> (<T_COMMA> <T_IDENT>)*;
#PlaceholderList: Placeholder() (<T_COMMA> Placeholder())*;
#ConflictClause: <T_ON> <T_CONFLICT> <T_LPAREN> IdentList() <T_RPAREN> <T_DO> <T_UPDATE> <T_SET> ConflictAssignments();
#ConflictAssignments: ConflictAssignment() (<T_COMMA> ConflictAssignment())*;
#ConflictAssignment: <T_IDENT> <T_EQ> ExcludedRef();
#ExcludedRef: <T_EXCLUDED> <T_DOT> <T_IDENT>;
#ReturningClause: <T_RETURNING> SelectList();
