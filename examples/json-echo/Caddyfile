{
	admin off
	auto_https off
	persist_config off
	storage file_system {
		root {$ZERNO_ROOT}/var/json-echo-caddy
	}
	servers {
		timeouts {
			read_body 10s
		}
	}
}

http://:18083 {
	bind 127.0.0.1
	@oversized expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 1048576`
	respond @oversized 413
	request_body {
		max_size 1MiB
	}
	reverse_proxy 127.0.0.1:19003 {
		request_buffers 1048577
		transport fastcgi {
			root {$ZERNO_ROOT}/public
			env SCRIPT_FILENAME {$ZERNO_ROOT}/public/http.php
			env SCRIPT_NAME /http.php
		}
	}
}
