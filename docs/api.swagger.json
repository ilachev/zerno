{
  "swagger": "2.0",
  "info": {
    "title": "app/v1/api.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "HealthService",
      "description": "Core runtime health endpoints"
    },
    {
      "name": "SystemService",
      "description": "Core runtime system endpoints"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns a minimal liveness response for the core runtime",
        "operationId": "HealthService_Check",
        "responses": {
          "200": {
            "description": "Runtime is healthy",
            "schema": {
              "$ref": "#/definitions/v1HealthCheckResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/system/describe": {
      "post": {
        "summary": "Describe runtime",
        "description": "Returns a neutral runtime description and echoes selected request fields",
        "operationId": "SystemService_Describe",
        "responses": {
          "200": {
            "description": "Runtime description",
            "schema": {
              "$ref": "#/definitions/v1SystemDescribeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "SystemDescribeRequest carries a neutral POST body for testing transport generation.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SystemDescribeRequest"
            }
          }
        ],
        "tags": [
          "system"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1HealthCheckResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "ok",
          "description": "Current health status"
        },
        "timestamp": {
          "type": "string",
          "format": "int64",
          "example": "1710000000",
          "description": "Unix timestamp when the response was created"
        }
      },
      "description": "HealthCheckResponse describes the current runtime state."
    },
    "v1SystemDescribeRequest": {
      "type": "object",
      "properties": {
        "caller": {
          "type": "string",
          "example": "client",
          "description": "Optional caller label to echo in the response"
        },
        "requestedCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Requested runtime capabilities to include when runtime data is enabled"
        },
        "includeRuntime": {
          "type": "boolean",
          "description": "Whether the response should include core runtime capabilities"
        }
      },
      "description": "SystemDescribeRequest carries a neutral POST body for testing transport generation."
    },
    "v1SystemDescribeResponse": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "zerno",
          "description": "Runtime name"
        },
        "mode": {
          "type": "string",
          "example": "core",
          "description": "Runtime mode"
        },
        "caller": {
          "type": "string",
          "example": "client",
          "description": "Echoed caller value"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Capabilities included in the neutral runtime description"
        },
        "runtimeIncluded": {
          "type": "boolean",
          "description": "Whether runtime capabilities were included"
        },
        "timestamp": {
          "type": "string",
          "format": "int64",
          "example": "1710000000",
          "description": "Unix timestamp when the response was created"
        }
      },
      "description": "SystemDescribeResponse describes the current neutral runtime state."
    }
  }
}
